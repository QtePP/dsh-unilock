{
  "format": 1,
  "id": "io.github.dsh-unilock.remote",
  "description": "command + cli + mcp subset. Reuses the same three unit directories without changing them; the MCP credential name is declared by its unit.",
  "profile": {
    "name": "unilock-remote",
    "bundles": ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app"]
  },
  "units": [
    { "id": "io.github.dsh-unilock.command", "version": "1.0.0" },
    { "id": "io.github.dsh-unilock.cli", "version": "1.0.0" },
    { "id": "io.github.dsh-unilock.mcp", "version": "1.0.0" }
  ],
  "patches": [
    { "id": "base", "file": "patches/00-base.patch.yml", "description": "Baseline rows." },
    { "id": "command", "file": "patches/10-command.patch.yml", "description": "Command plane." },
    { "id": "cli", "file": "patches/20-cli.patch.yml", "description": "Standalone CLI." },
    { "id": "mcp", "file": "patches/50-mcp.patch.yml", "description": "MCP connection." }
  ],
  "bindings": {},
  "credentialBindings": {}
}
